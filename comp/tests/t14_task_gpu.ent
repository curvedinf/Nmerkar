; t14_task_gpu.ent — weave tasks compiled to fused GPU kernels (v13.1)
; The `price` task is a straight-line elementwise chain over its inputs;
; the compiler fuses it into ONE kernel (inputs staged in once, every op
; on-device, result staged out once). Producer tasks with non-eligible ops
; (tensor construction from a global) decline fusion and run on CPU.
; NOTE: task bodies bind every intermediate explicitly (`x!`) — unbound
; cross-line stack values do not survive task frames (v13).
; Run: nkr --device cpu ... / uf ... (auto GPU); outputs must match.
; KNOWN FLAKY: depends on binary layout — a compiler rebuild can flip it
; between passing and a SIGSEGV inside uf_gc_alloc from a weave worker
; (pre-existing at v13 HEAD, reproduced with unmodified sources; same
; layout-sensitivity class as the t13 GC note). A crash here is not
; necessarily a regression.
2000000 n!
0 n@ range lst!
lst@ lst!
weave
  task kk:
    ret lst@ float tensor
  task s: kk!
    ret kk@ 0.000001 mul 100.0 add
  task k: kk!
    ret kk@ 0.0000005 mul 95.0 add
  task st: kk!
    ret kk@ 0.0000001 mul 0.2 add
  task price: s! k! st!
    s@ k@ div 1.0 sub a!
    st@ st@ mul 0.5 mul b!
    a@ b@ add c!
    c@ st@ div d1!
    d1@ st@ sub d2!
    d1@ d1@ mul w1!
9.8374183081777466e-27 ph1!
    ph1@ w1@ mul -2.4409281764270801e-24 add ph1!
    ph1@ w1@ mul 2.5200131520055621e-22 add ph1!
    ph1@ w1@ mul -1.3050099746435033e-20 add ph1!
    ph1@ w1@ mul 2.5294417305671556e-19 add ph1!
    ph1@ w1@ mul 8.3488823309250727e-18 add ph1!
    ph1@ w1@ mul -5.9769612419950018e-16 add ph1!
    ph1@ w1@ mul 6.7395099116704979e-15 add ph1!
    ph1@ w1@ mul 6.7639314645906397e-13 add ph1!
    ph1@ w1@ mul -4.2910324684542515e-11 add ph1!
    ph1@ w1@ mul 1.4305101232167135e-09 add ph1!
    ph1@ w1@ mul -3.3683815695296368e-08 add ph1!
    ph1@ w1@ mul 6.1709290701241611e-07 add ph1!
    ph1@ w1@ mul -9.2236015244880478e-06 add ph1!
    ph1@ w1@ mul 0.00011477352256159136 add ph1!
    ph1@ w1@ mul -0.0011861254737728477 add ph1!
    ph1@ w1@ mul 0.009972402563565597 add ph1!
    ph1@ w1@ mul -0.066489940262615232 add ph1!
    ph1@ w1@ mul 0.39894225252808718 add ph1!
    d1@ ph1@ mul 0.5 add nc1!
    d2@ d2@ mul w2!
9.8374183081777466e-27 ph2!
    ph2@ w2@ mul -2.4409281764270801e-24 add ph2!
    ph2@ w2@ mul 2.5200131520055621e-22 add ph2!
    ph2@ w2@ mul -1.3050099746435033e-20 add ph2!
    ph2@ w2@ mul 2.5294417305671556e-19 add ph2!
    ph2@ w2@ mul 8.3488823309250727e-18 add ph2!
    ph2@ w2@ mul -5.9769612419950018e-16 add ph2!
    ph2@ w2@ mul 6.7395099116704979e-15 add ph2!
    ph2@ w2@ mul 6.7639314645906397e-13 add ph2!
    ph2@ w2@ mul -4.2910324684542515e-11 add ph2!
    ph2@ w2@ mul 1.4305101232167135e-09 add ph2!
    ph2@ w2@ mul -3.3683815695296368e-08 add ph2!
    ph2@ w2@ mul 6.1709290701241611e-07 add ph2!
    ph2@ w2@ mul -9.2236015244880478e-06 add ph2!
    ph2@ w2@ mul 0.00011477352256159136 add ph2!
    ph2@ w2@ mul -0.0011861254737728477 add ph2!
    ph2@ w2@ mul 0.009972402563565597 add ph2!
    ph2@ w2@ mul -0.066489940262615232 add ph2!
    ph2@ w2@ mul 0.39894225252808718 add ph2!
    d2@ ph2@ mul 0.5 add nc2!
    s@ nc1@ mul t1!
    k@ 0.98511193960306265 mul t2!
    t2@ nc2@ mul t3!
    t1@ t3@ sub pr!
    ret pr@
run
p!
"premium_sum: " print p@ sum "%.2f" format print
"sample[0]: " print p@ 0 get "%.6f" format print
"sample[N-1]: " print p@ 1999999 get "%.6f" format print
ret
