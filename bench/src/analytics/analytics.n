; analytics.n — v13: sales CSV analytics (bench/SPEC.md)
; Columns: [2] region, [3] country, [4] product, [7] units, [10] total
0 rows! 0.0 rev! 0 units!
dict region_d! dict prod_d! dict country_d!
1 first!
argv 1 get f!
f "," 0 'row file_split_lines
"=== DATA ANALYTICS RESULTS ===" print
rows "total_rows: %d" format print
rev "total_revenue: %.2f" format print
rev rows div "avg_order: %.2f" format print
units "total_units: %d" format print
region_d 6 top_n "region_%d: %s $%.2f" _call pr
prod_d 5 top_n "product_%d: %s $%.2f" _call pr
country_d 3 top_n "country_%d: %s $%.2f" _call pr
ret
row: acc! n!
  first 'reset 'accum if_else
  ret acc
reset:
  0 first!
  ret
accum:
  rows++
  10 field_float t!
  t rev+=
  region_d 2 t field_add_to
  prod_d 4 t field_add_to
  country_d 3 t field_add_to
  7 field_int units+=
  ret
pr: lst! fmt!
  lst length 'p for
  ret
p: k! lst k get e!
  k 1 add e 0 get e 1 get fmt format print
  ret 0
