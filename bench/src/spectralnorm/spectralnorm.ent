; spectralnorm variant: eval_A computed inline, no A matrix (matches C++ memory pattern)
5500 n!
has_args 'argn if
n@ float array v!
n@ float array u!
n@ float array tmp!
0 i!
'ic 'ib while
10 'power for
0 uvt! 0 vvt!
n@ 'dots for
uvt@ vvt@ div sqrt "%.9f" format print
ret
argn:
  1 arg_index n!
  ret
ic:
  ret i@ n@ lt
ib:
  u@ i@ 1.0 array_set
  v@ i@ 0.0 array_set
  ret i@ 1 add i!
power: k!
  tmp@ u@ n@ _call mv
  v@ tmp@ n@ _call tm
  tmp@ v@ n@ _call mv
  u@ tmp@ n@ _call tm
  ret
; mv(dst,src,n): dst[i] = sum_j src[j] * eval_A(i,j)
mv: dst! src! nn!
  0 mi!
  'mc 'mb while
  ret 0
mc:
  ret mi@ nn@ lt
mb:
  0 ms! 0 mj!
  'jc 'jb while
  dst@ mi@ ms@ array_set
  ret mi@ 1 add mi!
jc:
  ret mj@ nn@ lt
jb:
  mi@ mj@ add mij!
  mij@ mij@ 1 add mul 2 div mi@ add 1 add mden!
  src@ mj@ array_get 1.0 mden@ div mul ms@ add ms!
  ret mj@ 1 add mj!
; tm(dst,src,n): dst[i] = sum_j src[j] * eval_A(j,i)
tm: dst! src! nn!
  0 ti!
  'tc 'tb while
  ret 0
tc:
  ret ti@ nn@ lt
tb:
  0 ts! 0 tj!
  'dc 'db while
  dst@ ti@ ts@ array_set
  ret ti@ 1 add ti!
dc:
  ret tj@ nn@ lt
db:
  tj@ ti@ add ji!
  ji@ ji@ 1 add mul 2 div tj@ add 1 add tden!
  src@ tj@ array_get 1.0 tden@ div mul ts@ add ts!
  ret tj@ 1 add tj!
dots: k!
  u@ k@ array_get v@ k@ array_get mul uvt@ add uvt!
  v@ k@ array_get v@ k@ array_get mul vvt@ add vvt!
  ret 0
