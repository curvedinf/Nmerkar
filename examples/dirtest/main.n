; main.n — directory mode test entry point
import c"usleep"(int)->int

; use a shared helper from util.n
42 'double "%d" format print

; get the background service's channel (retry until bg thread has created it)
wcond wbody while

ch "hello from main" enqueue

; give bg thread time to receive and print
100000 'usleep

"main done" print
0 ret
wcond:
  'bg_chan ch! ch
  0 eq ret
wbody:
  1000 'usleep
  0 ret
