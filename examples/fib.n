; fib.n — iterative fibonacci via while with addr-bound cond/body labels
entry:
  0 v0!               ; v0 = F(k), starting at F(0) = 0
  1 v1!               ; v1 = F(k+1), starting at F(1) = 1
  20 v2!              ; v2 = iterations remaining
  _addr v3            ; push address of the condition body (v3)
  _addr v4            ; push address of the loop body (v4)
  while               ; call v3 each round; run v4 until it returns 0
  v0@                 ; push the final F(20)
  "fib(20)=%d" format ; render with the printf-style template
  print               ; write the formatted string
  ret                 ; return from the body (required at end of every body)
v3:                   ; loop condition: continue while v2 > 0
  v2@ 0 gt            ; push (v2 > 0)
  ret
v4:                   ; loop body: advance one fibonacci step
  v0@ v1@ add v5!     ; v5 = v0 + v1 (the next value)
  v1@ v0!             ; v0 = v1
  v5@ v1!             ; v1 = v5
  v2@ 1 sub v2!       ; v2 = v2 - 1
  0                   ; body return value (discarded by while)
  ret
