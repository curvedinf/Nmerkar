; blackscholes.ent — GPU-oriented black-scholes-style pricing (bench/SPEC.md)
; N from argv[1] (default 2000000). Fully elementwise polymorphic arithmetic;
; N(x) = 0.5 + x*S(x^2) with the SPEC-pinned 19-coefficient polynomial,
; evaluated once over the concatenated [d1 d2] vector then split back;
; discount D = e^(-rT) pinned as a constant (r=0.02, T=0.75).
2000000 n!
has_args 'setn if
0 n@ range lst!
lst@ float tensor kk!
kk@ 0.000001 mul 100.0 add ss!     ; S = 100 + 1e-6 k
kk@ 0.0000005 mul 95.0 add ks!     ; K = 95 + 5e-7 k
kk@ 0.0000001 mul 0.2 add st!      ; sigT = 0.2 + 1e-7 k
ss@ ks@ div 1.0 sub                ; (S/K) - 1
st@ st@ mul 0.5 mul add            ; + 0.5 sigT^2
st@ div d1!                        ; d1 = ... / sigT
d1@ st@ sub d2!
d1@ d2@ concat dw!                 ; [d1 d2] — one chain for both
dw@ dw@ mul w!
9.8374183081777466e-27 ph!
ph@ w@ mul -2.4409281764270801e-24 add ph!
ph@ w@ mul 2.5200131520055621e-22 add ph!
ph@ w@ mul -1.3050099746435033e-20 add ph!
ph@ w@ mul 2.5294417305671556e-19 add ph!
ph@ w@ mul 8.3488823309250727e-18 add ph!
ph@ w@ mul -5.9769612419950018e-16 add ph!
ph@ w@ mul 6.7395099116704979e-15 add ph!
ph@ w@ mul 6.7639314645906397e-13 add ph!
ph@ w@ mul -4.2910324684542515e-11 add ph!
ph@ w@ mul 1.4305101232167135e-09 add ph!
ph@ w@ mul -3.3683815695296368e-08 add ph!
ph@ w@ mul 6.1709290701241611e-07 add ph!
ph@ w@ mul -9.2236015244880478e-06 add ph!
ph@ w@ mul 0.00011477352256159136 add ph!
ph@ w@ mul -0.0011861254737728477 add ph!
ph@ w@ mul 0.009972402563565597 add ph!
ph@ w@ mul -0.066489940262615232 add ph!
ph@ w@ mul 0.39894225252808718 add ph!
0.5 dw@ ph@ mul add nc!            ; N(d) over [d1 d2]
nc@ 0 n@ slice nc1!                ; N(d1)
nc@ n@ n@ 2 mul slice nc2!         ; N(d2)
ss@ nc1@ mul ks@ 0.98511193960306265 mul nc2@ mul sub pr!
"premium_sum: " print pr@ sum "%.2f" format print
"sample[0]: " print pr@ 0 get "%.6f" format print
"sample[N-1]: " print pr@ n@ 1 sub get "%.6f" format print
ret
setn: 1 arg_index n! ret
