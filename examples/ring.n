; ring.n — v13: spawn + channel, and a weave DAG
; (the channel is a global: locals are frame-scoped and the post-weave
;  code runs in its own body frame)
'sender spawn ch!     ; spawn sender in a detached thread; ch (global) = its result channel
weave                 ; begin task-DAG definition
  task one:           ; task `one` — no inputs
    ret 21            ; task result = 21
  task two: one!      ; task `two` depends on `one`, binding its result to one
    ret one@ 2 mul    ; task result = one * 2 = 42
run two               ; execute the DAG rooted at `two`; result lands on the stack
print                 ; prints the weave result (42)
ch@ dequeue print     ; join the spawned thread: dequeue its result (42) and print
sender:               ; spawned thread body
  ret 42              ; return value is enqueued to ch, then ch closes
