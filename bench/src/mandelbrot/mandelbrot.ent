; mandelbrot.ent — v13: mandelbrot escape count (bench/SPEC.md).
; esc(cx,cy) runs the iteration with zr/zi in register-cached locals inside
; an outlined function — no array traffic, tight loop.
1000 n!
has_args 'argn if
0 cnt!
n@ 'row for
cnt@ "%d" format print
ret
argn:
  1 arg_index n!
  ret
row: k!
  2.0 k@ mul n@ div 1.0 sub cy!
  n@ 'col for
  ret
col: k!
  2.0 k@ mul n@ div 1.5 sub cx!
  cx@ cy@ _call esc
  cnt@ add cnt!
  ret
; esc(cx,cy): zr←zr²-zi²+cx, zi←2·zr·zi+cy for up to 50 iters;
; returns 1 if the point stayed bounded (zr²+zi²<=4), else 0.
esc: cx! cy!
  0.0 zr! 0.0 zi! 0 it!
  'ec 'eb while
  zr@ zr@ mul zi@ zi@ mul add 4.0 gt not
  ret
ec:
  it@ 50 lt zr@ zr@ mul zi@ zi@ mul add 4.0 gt not and
  ret
eb:
  zr@ zr@ mul zi@ zi@ mul sub cx@ add nzr!
  zr@ zi@ 2.0 mul mul cy@ add zi!
  nzr@ zr!
  it++
  0
  ret
