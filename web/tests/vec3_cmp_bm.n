; comparisons -> bitmap; bitmap logic; gather; where; bitmap iteration
list 1 append 3 append 2 append 5 append 4 append 0 array a!
;a = [1,3,2,5,4]
a 3 scalar_eq e!
"eq(3) count: " print e bitmap_count print
a 2.5 scalar_lt lb!
"lt(2.5) count: " print lb bitmap_count print
a 2.5 scalar_gt gtb!
a 2.5 scalar_gte gteb!
a 2.5 scalar_lte ltb!
"gt count: " print gtb bitmap_count print
"gte count: " print gteb bitmap_count print
"lte count: " print ltb bitmap_count print
e lb bitmap_and and_!
"and count: " print and_ bitmap_count print
e lb bitmap_or or_!
"or count: " print or_ bitmap_count print
e bitmap_not notb!
"not count: " print notb bitmap_count print
;70-bit bitmap: word-boundary + tail masking
70 0 array a70!
a70 0.5 scalar_gt bm70!
"empty bm len: " print bm70 length print
bm70 bitmap_not all70!
"not(empty) count: " print all70 bitmap_count print
all70 length print
a70 3 scalar_eq e3!
e3 all70 bitmap_and an_!
"bit3 count: " print an_ bitmap_count print
;gather keeps set-bit elements
a e array_gather g!
"gather(eq3): " print g print
a lb array_gather g2!
"gather(lt): " print g2 print
;where: (a, b, bm) bit set -> a else b
5 0 array z!
a z e array_where w!
"where: " print w print
;bitmap iteration yields set-bit indices in order
e iter collect print
lb iter collect print
notb iter collect print
all70 iter collect length print
;bitmap len/typeof/print
e length print
e type_of print
e print
;int scalar coerced for comparisons
a 3.0 scalar_eq ef!
"int arr vs float scalar: " print ef bitmap_count print
;bool array comparison
[1 0 1] bool array ba!
ba 1 scalar_eq beq!
"bool eq count: " print beq bitmap_count print
"bool sum: " print ba sum print
"bool mean: " print ba mean print
;byte array comparison
[10 200 5] byte array bya!
bya 100 scalar_gt bygt!
"byte gt count: " print bygt bitmap_count print
ret
