; matmul.n — GPU-oriented matmul benchmark (bench/SPEC.md)
; C = A*B, N x N double matrices, row-major, N from argv[1] (default 512).
;   A[k] = 1.0 + 1e-6*k   (k = row*N + col)
;   B[k] = 1.0 - 1e-6*k
; Matrices are built via [rows cols v0...] data lists (no fill loops); the
; weave task `mmul` contains exactly one op (`mul`) — the auto device
; dispatches it as a GPU matmul kernel launch; --device cpu runs it inline.
512 n!
has_args 'setn if
n@ n@ mul n2!
[n@ n@] 0 n2@ range concat float tensor kmat!
kmat@ 0.000001 mul 1.0 add a!
1.0 kmat@ 0.000001 mul sub b!
weave
  task mmul:
    ret a@ b@ mul
run mmul
c!
"c[0,0]: " print c@ 0 get "%.6f" format print
"c[N-1,N-1]: " print c@ n2@ 1 sub get "%.6f" format print
"checksum: " print c@ sum "%.2f" format print
ret
setn: 1 arg_index n! ret
